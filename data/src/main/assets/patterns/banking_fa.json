  "structure": {
    "amount_signed": "(?<![\\d/\\-.:])[+\\-−]\\s*\\d[\\d,٬،\\s]*\\d\\s*(ريال|ریال|تومان|تومن|irr|toman)?",
    "amount_any": "\\d[\\d,٬،\\s]{0,14}\\d\\s*(ريال|ریال|تومان|تومن|irr|toman|rial)",
    "balance": "مانده\\s*(حساب|کارت|مبلغ|قسط|ریال|تومان|[:؛=\\-]|\\d)|باقیمانده|موجودي\\s*(حساب|کارت|مبلغ|[:؛=\\-]|\\d)?|موجودی\\s*(حساب|کارت|مبلغ|[:؛=\\-]|\\d)?|balance",
