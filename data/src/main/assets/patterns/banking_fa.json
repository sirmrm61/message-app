    "jalali_datetime": "14\\d\\d[/\\-.]\\d{1,2}[/\\-.]\\d{1,2}|\\d{1,2}[/\\-.]\\d{1,2}[/\\-.]14\\d\\d|ساعت\\s*\\d{1,2}[:\\d]*",
    "ref_or_serial": "کد\\s*(پیگیری|رهگیری|مرجع|رصد)|شماره\\s*(پیگیری|مرجع|سری|سریال|حواله|تراکنش)|ref(erence)?\\s*[:#]?\\s*\\d|پیگیری\\s*[:#]?\\s*\\d{4,}|سریال\\s*[:#]?\\s*\\d",
    "otp_code": "رمز\\s*(دوم\\s*)?پویا|رمز\\s*(یک\\s*بار|یکبار)\\s*مصرف|کد\\s*(تایید|تأیید|فعال\\s*سازی|ورود|احراز|امنیتی)|otp",
    "security_event": "ورود به (اینترنت\\s*بانک|همراه\\s*بانک|همراه|سامانه|اپلیکیشن|درگاه)|ورود موفق|ورود ناموفق|تغییر رمز|فعال.?سازی|رمز دوم|خروج موفق|غیرفعال شد|کاربر جدید|همراه بانک"
